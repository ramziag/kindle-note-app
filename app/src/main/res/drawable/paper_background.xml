<?xml version="1.0" encoding="utf-8"?>
<!-- Cream page with gently darkened edges, like an old paperback. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#00000000"
                android:endColor="#1A8B6F47"
                android:startColor="#1A8B6F47" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#00000000"
                android:endColor="#128B6F47"
                android:startColor="#128B6F47" />
        </shape>
    </item>
</layer-list>
