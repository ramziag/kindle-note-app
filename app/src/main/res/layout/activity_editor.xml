<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp">

        <!-- Labelled in code with the notebook the note belongs to. -->
        <TextView
            android:id="@+id/back"
            style="@style/TopBarButton"
            android:ellipsize="end"
            android:maxWidth="@dimen/back_max_width"
            android:singleLine="true" />

        <TextView
            android:id="@+id/date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/ink_faint"
            android:textSize="14sp"
            android:textStyle="italic"
            android:typeface="serif" />

        <TextView
            android:id="@+id/appearance"
            style="@style/TopBarButton"
            android:text="@string/appearance" />

        <TextView
            android:id="@+id/delete"
            style="@style/TopBarButton"
            android:text="@string/delete" />
    </LinearLayout>

    <!-- Text size, typeface and line spacing, shown by the "Aa" button. -->
    <LinearLayout
        android:id="@+id/appearance_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/appearance_panel"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/smaller"
                style="@style/TopBarButton"
                android:contentDescription="@string/smaller_text"
                android:text="A−"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/size_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minWidth="36dp"
                android:textColor="@color/ink_soft"
                android:textSize="16sp"
                android:typeface="serif" />

            <TextView
                android:id="@+id/larger"
                style="@style/TopBarButton"
                android:contentDescription="@string/larger_text"
                android:text="A+"
                android:textSize="24sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:background="@color/rule" />

            <TextView
                android:id="@+id/typeface"
                style="@style/TopBarButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ink" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="14dp"
                    android:paddingRight="4dp"
                    android:text="@string/spacing_label"
                    android:textColor="@color/ink_faint"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:typeface="serif" />

                <TextView
                    android:id="@+id/spacing_compact"
                    style="@style/Segment"
                    android:text="@string/spacing_compact" />

                <TextView
                    android:id="@+id/spacing_normal"
                    style="@style/Segment"
                    android:text="@string/spacing_normal" />

                <TextView
                    android:id="@+id/spacing_relaxed"
                    style="@style/Segment"
                    android:text="@string/spacing_relaxed" />

                <TextView
                    android:id="@+id/spacing_wide"
                    style="@style/Segment"
                    android:text="@string/spacing_wide" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <EditText
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#00000000"
            android:gravity="top|left"
            android:hint="@string/write_hint"
            android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
            android:paddingBottom="48dp"
            android:paddingLeft="@dimen/page_margin_wide"
            android:paddingRight="@dimen/page_margin_wide"
            android:paddingTop="12dp"
            android:textColor="@color/ink"
            android:textSize="@dimen/body_text"
            android:typeface="serif" />
    </ScrollView>

    <!-- Footer styled like the running foot of a book page. -->
    <TextView
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="10dp"
        android:paddingTop="6dp"
        android:textColor="@color/ink_faint"
        android:textSize="14sp"
        android:textStyle="italic"
        android:typeface="serif" />
</LinearLayout>
