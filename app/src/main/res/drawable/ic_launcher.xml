<?xml version="1.0" encoding="utf-8"?>
<!-- A cream page with a red bookmark ribbon and a few lines of "text", on a 48dp canvas. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <size
                android:width="48dp"
                android:height="48dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="6dp"
        android:right="6dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
            <stroke
                android:width="1.5dp"
                android:color="#A08A66" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item
        android:bottom="33dp"
        android:left="12dp"
        android:right="18dp"
        android:top="13dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
        </shape>
    </item>
    <item
        android:bottom="27dp"
        android:left="12dp"
        android:right="12dp"
        android:top="20dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_faint" />
        </shape>
    </item>
    <item
        android:bottom="22dp"
        android:left="12dp"
        android:right="14dp"
        android:top="25dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_faint" />
        </shape>
    </item>
    <item
        android:bottom="17dp"
        android:left="12dp"
        android:right="12dp"
        android:top="30dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_faint" />
        </shape>
    </item>
    <item
        android:bottom="12dp"
        android:left="12dp"
        android:right="20dp"
        android:top="35dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_faint" />
        </shape>
    </item>
    <item
        android:bottom="34dp"
        android:left="32dp"
        android:right="10dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
        </shape>
    </item>
</layer-list>
