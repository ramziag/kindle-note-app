<?xml version="1.0" encoding="utf-8"?>
<!-- A faintly shaded band with hairline rules above and below. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F8B6F47" />
        </shape>
    </item>
    <item
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="@color/rule" />
        </shape>
    </item>
</layer-list>
