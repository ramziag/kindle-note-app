<?xml version="1.0" encoding="utf-8"?>
<!-- Shows one folder: the top-level Notes folder or a notebook inside it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingLeft="@dimen/page_margin"
    android:paddingRight="@dimen/page_margin">

    <!-- Pulled out by the buttons' own padding so their text lines up with the page margin. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="-14dp"
        android:layout_marginRight="-14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <!-- Back to the enclosing notebook; hidden at the top level. -->
        <TextView
            android:id="@+id/back"
            style="@style/TopBarButton"
            android:ellipsize="end"
            android:maxWidth="@dimen/back_max_width"
            android:singleLine="true"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/new_notebook"
            style="@style/TopBarButton"
            android:text="@string/new_notebook" />

        <TextView
            android:id="@+id/new_note"
            style="@style/TopBarButton"
            android:text="@string/new_note" />
    </LinearLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textSize="32sp"
        android:textStyle="italic"
        android:typeface="serif" />

    <!-- Ornamental rule, like a chapter heading divider. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="—— ❦ ——"
        android:textColor="@color/ink_faint"
        android:textSize="16sp"
        android:typeface="serif" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/note_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="#00000000"
            android:divider="@color/rule"
            android:dividerHeight="1px"
            android:listSelector="#00000000" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:padding="32dp"
            android:textColor="@color/ink_soft"
            android:textSize="20sp"
            android:textStyle="italic"
            android:typeface="serif" />
    </FrameLayout>

    <TextView
        android:id="@+id/folder_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="10dp"
        android:paddingTop="8dp"
        android:textColor="@color/ink_faint"
        android:textSize="13sp"
        android:typeface="serif" />
</LinearLayout>
